# Shopify store domain only, e.g. your-store.myshopify.com (no protocol)
SHOPIFY_STORE_DOMAIN=
# Public Storefront API access token from Shopify's Headless sales channel
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Use a stable Storefront API version. Override when upgrading deliberately.
SHOPIFY_API_VERSION=2026-07
# Comma-separated namespace.key identifiers for public product metafields
SHOPIFY_PRODUCT_METAFIELDS=wipelo.function,wipelo.active,wipelo.skin_type,wipelo.directions,wipelo.ingredients,wipelo.free_from,wipelo.features,wipelo.pdp_content
# Optional override for the subscription portal link. Defaults to https://<store-domain>/account
NEXT_PUBLIC_SHOPIFY_ACCOUNT_URL=
