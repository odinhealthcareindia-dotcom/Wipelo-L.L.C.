# Shopify store domain only, e.g. your-store.myshopify.com (no protocol)
SHOPIFY_STORE_DOMAIN=
# Public Storefront API access token from Shopify's Headless sales channel
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Use a stable Storefront API version. Override when upgrading deliberately.
SHOPIFY_API_VERSION=2026-07
# Comma-separated namespace.key identifiers for public product metafields
SHOPIFY_PRODUCT_METAFIELDS=wipelo.function,wipelo.active,wipelo.skin_type,wipelo.directions,wipelo.ingredients,wipelo.free_from,wipelo.features,wipelo.pdp_content
# Optional override for the subscription portal link. Defaults to https://<store-domain>/account
NEXT_PUBLIC_SHOPIFY_ACCOUNT_URL=

# ---- Customer accounts (server-only: never prefix these with NEXT_PUBLIC_). Leave unset to run guest-only. ----

# Shopify Admin > Sales channels > Headless > your storefront > Customer Account API > Credentials
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# Encrypts the session cookies. 32 random bytes, base64. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Optional. The previous secret, kept for decryption only while rotating SESSION_SECRET.
SESSION_SECRET_PREVIOUS=
# Required in production. Comma-separated origins this site is served from. The first is canonical.
APP_ORIGINS=https://wipelo.com,https://www.wipelo.com
# Optional. Pinned Customer Account API version. Defaults to the version our operations are validated against.
SHOPIFY_CUSTOMER_API_VERSION=2026-10
# Optional. PKCE is sent by default. Shopify documents it for public clients; set false only if sign-in rejects it.
SHOPIFY_CUSTOMER_ACCOUNT_PKCE=true
